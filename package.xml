<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kfs_core</name>
  <version>1.0.0</version>
  <description>
    KFS 实时目标检测核心库 — 相机捕获 (RealSense/USB) + YOLO11 ONNX 推理。
    纯逻辑层，无 ROS 依赖，可被 ROS2 节点直接链接使用。
  </description>

  <maintainer email="user@example.com">KFS Team</maintainer>
  <license>MIT</license>

  <!-- 系统依赖 (通过 apt 安装) -->
  <depend>libopencv-dev</depend>
  <depend>libyaml-cpp-dev</depend>
  <depend>libonnxruntime-dev</depend>
  <depend>librealsense2-dev</depend>

  <!-- ROS2 运行时依赖 -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>

  <!-- ROS2 构建依赖 -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>

  <!-- 声明本包是 ROS2 接口包 -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
